---
import { stats } from "../data/site";
---

<section class="on-dark bg-ink text-white">
  <div class="wrap grid grid-cols-2 gap-y-10 py-14 md:grid-cols-4 md:py-16">
    {
      stats.map((s, i) => (
        <div
          class="border-white/10 px-2 text-center md:px-6 [&:not(:nth-child(2n))]:border-r md:[&:not(:last-child)]:border-r md:[&:nth-child(2n)]:border-r"
          data-reveal
          style={`--reveal-delay:${i * 70}ms`}
        >
          <p class="font-display text-[2.2rem] leading-none md:text-[2.9rem]">
            {s.value}
          </p>
          <p class="mt-3 text-[0.82rem] tracking-wide text-white/55">{s.label}</p>
        </div>
      ))
    }
  </div>
</section>

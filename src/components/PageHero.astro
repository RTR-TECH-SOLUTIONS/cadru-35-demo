---
import { url } from "../lib/url";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Ornament from "./Ornament.astro";

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  image: ImageMetadata;
  alt: string;
}

const { eyebrow, title, text, image, alt } = Astro.props;
---

<section class="on-dark relative bg-ink text-white" style="padding-top: var(--header-h)">
  <div class="wrap grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <div data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h-hero mt-5 text-white" data-split>{title}</h1>
      <p class="lead mt-7 max-w-xl">{text}</p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={url("/contact")} class="btn btn-accent">
          Cere o ofertă
          <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M3 10h13M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href={url("/portofoliu")} class="btn btn-light">
          Vezi portofoliul
        </a>
      </div>
    </div>

    <div class="relative" data-reveal="right" style="--reveal-delay:120ms">
      <Ornament
        type="crop"
        class="pointer-events-none absolute -right-4 -top-6 h-10 w-10 text-white/35 md:h-12 md:w-12"
      />
      <div class="frame">
        <Image
          src={image}
          alt={alt}
          widths={[520, 780, 1100]}
          sizes="(min-width:1024px) 44vw, 92vw"
          class="aspect-[4/3] w-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

---
/**
 * Banda de sub hero. În referință sunt logo-urile clienților; aici e eticheta
 * rolei: formatul, apoi ce se trage pe ea. Nu inventăm branduri care ne-ar
 * recomanda.
 * TODO(real): dacă apar clienți dispuși, aici intră logo-urile lor.
 */
const items = [
  "Foto studio",
  "Nuntă",
  "Botez",
  "Video de eveniment",
  "Corporate",
  "Portret",
];
---

<section class="bg-accent text-ink">
  <div class="wrap flex flex-wrap items-center gap-x-7 gap-y-2 py-3.5">
    <span
      class="rebate shrink-0 border border-ink/35 px-2 py-1 !text-ink"
      aria-hidden="true">35 mm</span
    >
    {
      items.map((item, i) => (
        <>
          {i > 0 && (
            <span class="hidden h-3 w-px bg-ink/30 sm:block" aria-hidden="true" />
          )}
          <span
            class="text-[13px] font-semibold uppercase tracking-[0.16em]"
            data-reveal="in"
            style={`--reveal-delay:${100 + i * 100}ms`}
          >
            {item}
          </span>
        </>
      ))
    }
  </div>
</section>

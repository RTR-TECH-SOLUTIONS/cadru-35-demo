---
import { url } from "../lib/url";
import Ornament from "./Ornament.astro";

interface Props {
  title?: string;
  text?: string;
  cta?: string;
  href?: string;
}
const {
  title = "Un cadru bun se pregătește din timp",
  text = "Spune-ne data și tipul evenimentului. Îți răspundem cu disponibilitatea și un preț ferm în aceeași zi.",
  cta = "Contactează-ne",
  href = "/contact",
} = Astro.props;
---

<section class="section-lg relative overflow-hidden bg-paper-alt">
  <Ornament
    type="grid"
    class="pointer-events-none absolute -left-6 top-10 hidden h-20 w-32 text-ink/15 xl:block"
  />
  <Ornament
    type="crosshair"
    class="pointer-events-none absolute right-[7%] bottom-10 hidden h-14 w-14 text-accent/70 xl:block"
  />
  <div class="wrap text-center">
    <h2 class="h-section mx-auto max-w-[900px]" data-split>{title}</h2>
    <p class="lead mx-auto mt-7 max-w-[720px]" data-reveal style="--reveal-delay:200ms">
      {text}
    </p>
    <a href={url(href)} class="btn btn-accent mt-10" data-reveal style="--reveal-delay:400ms">
      {cta}
    </a>
  </div>
</section>

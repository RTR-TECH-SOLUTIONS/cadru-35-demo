---
import Mark from "./Mark.astro";
interface Props {
  eyebrow?: string;
  title: string;
  /** ultimul cuvânt primește colțarele de vizor; se folosește rar */
  markLast?: boolean;
  text?: string;
  align?: "left" | "center";
  class?: string;
}
const {
  eyebrow,
  title,
  markLast = false,
  text,
  align = "center",
  class: className = "",
} = Astro.props;

const words = title.split(" ");
const last = markLast ? words.pop() : null;
const head = words.join(" ");
---

<div class:list={[align === "center" ? "text-center" : "", className]}>
  {eyebrow && <p class="eyebrow mb-5" data-reveal>{eyebrow}</p>}
  <h2 class="h-section" data-split>
    {head}{last && <> <Mark text={last} /></>}
  </h2>
  {
    text && (
      <p
        class:list={["lead mt-6", align === "center" && "mx-auto max-w-[780px]"]}
        data-reveal
        style="--reveal-delay:200ms"
      >
        {text}
      </p>
    )
  }
</div>

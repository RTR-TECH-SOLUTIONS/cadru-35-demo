---
interface Props {
  tone?: "light" | "dark";
  class?: string;
}
const { tone = "light", class: className = "" } = Astro.props;
const text = tone === "light" ? "#ffffff" : "#0d0d0d";
---

<span class={`flex items-center gap-3 ${className}`}>
  <svg
    class="h-9 w-9 shrink-0 lg:h-10 lg:w-10"
    viewBox="0 0 48 48"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="24" cy="24" r="21" stroke="var(--color-accent)" stroke-width="2"></circle>
    <path
      d="M24 3.5 33 19M45 24 27 24M38.5 38.5 29 23M24 44.5 15 29M3.5 24 21 24M9.5 9.5 19 25"
      stroke="var(--color-accent)"
      stroke-width="1.6"
      stroke-linecap="round"
      opacity="0.85"></path>
    <circle cx="24" cy="24" r="5.5" fill="var(--color-accent)"></circle>
  </svg>
  <span class="font-display leading-none" style={`color:${text}`}>
    <span class="block text-[0.95rem] tracking-[0.34em] lg:text-[1.05rem]">CADRU</span>
    <span class="mt-[3px] block text-[0.72rem] tracking-[0.30em] lg:text-[0.78rem]"
      >35 &nbsp;STUDIO</span
    >
  </span>
</span>

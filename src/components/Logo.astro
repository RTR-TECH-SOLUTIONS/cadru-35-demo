---
/**
 * Doar numele, fără marcă grafică. Clientul își aduce logo-ul lui.
 * TODO(real): dacă vine cu un logo, se pune aici în locul textului.
 */
interface Props {
  tone?: "light" | "dark";
  class?: string;
}
const { tone = "light", class: className = "" } = Astro.props;
const text = tone === "light" ? "#ffffff" : "var(--color-ink)";
---

<span class={`leading-none ${className}`} style={`color:${text}`}>
  <span class="block font-display text-[22px] font-semibold tracking-[0.01em]">Placeholder</span>
  <span class="rebate mt-1.5 block !text-current opacity-55">Studio foto · video</span>
</span>

---
interface Props {
  tone?: "light" | "dark";
  class?: string;
}
const { tone = "light", class: className = "" } = Astro.props;
const text = tone === "light" ? "#ffffff" : "#000000";
---

<span class={`flex items-center gap-3 ${className}`}>
  <svg class="h-11 w-11 shrink-0" viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <circle cx="24" cy="24" r="21" stroke="var(--color-accent)" stroke-width="2"></circle>
    <path
      d="M24 3.5 33 19M45 24 27 24M38.5 38.5 29 23M24 44.5 15 29M3.5 24 21 24M9.5 9.5 19 25"
      stroke="var(--color-accent)"
      stroke-width="1.6"
      stroke-linecap="round"
      opacity="0.85"></path>
    <circle cx="24" cy="24" r="5.5" fill="var(--color-accent)"></circle>
  </svg>
  <span class="leading-none" style={`color:${text}; font-family: var(--font-display)`}>
    <span class="block text-[19px] tracking-[0.28em]">CADRU</span>
    <span class="mt-[5px] block text-[13px] tracking-[0.26em]">35&nbsp;&nbsp;STUDIO</span>
  </span>
</span>

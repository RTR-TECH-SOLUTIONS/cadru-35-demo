---
interface Step {
  title: string;
  text: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<ol class="grid gap-px overflow-hidden rounded-xl bg-line md:grid-cols-2 lg:grid-cols-4">
  {
    steps.map((step, i) => (
      <li
        class="bg-cream p-7 md:p-8"
        data-reveal
        style={`--reveal-delay:${i * 80}ms`}
      >
        <span class="font-display text-[2.6rem] leading-none text-accent">
          {String(i + 1).padStart(2, "0")}
        </span>
        <h3 class="mt-5 font-display text-[1.3rem] leading-tight">{step.title}</h3>
        <p class="mt-3 text-[0.94rem] leading-relaxed text-muted">{step.text}</p>
      </li>
    ))
  }
</ol>

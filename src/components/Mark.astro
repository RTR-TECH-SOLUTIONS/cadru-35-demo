---
/**
 * Ultimul cuvânt dintr-un titlu, cu sublinierea roz desenată de mână
 * (în referință e tot un SVG scalat pe lățimea cuvântului, nu un border).
 */
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<span class="mark"
  >{text}<svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true" fill="none"
    ><path
      d="M3 17.5c38-6.2 96-10.4 150-10.9 40-.4 82 1.7 144 7.6"
      stroke="currentColor"
      stroke-width="3.4"
      stroke-linecap="round"></path><path
      d="M14 21.5c52-4.4 104-6.6 156-6.4 38 .1 76 1.4 126 4.6"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      opacity="0.55"></path></svg
  ></span
>

---
import { url } from "../lib/url";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Mark from "../components/Mark.astro";
import Ornament from "../components/Ornament.astro";
import Perfs from "../components/Perfs.astro";
import SectionHead from "../components/SectionHead.astro";
import ContactSheet from "../components/ContactSheet.astro";
import LogoBar from "../components/LogoBar.astro";
import Marquee from "../components/Marquee.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/site";

import pFashion from "../assets/img/p-fashion.jpg";
import heroNunta from "../assets/img/hero-nunta.jpg";
import heroVideo from "../assets/img/hero-video.jpg";
import studioLumini from "../assets/img/studio-lumini.jpg";
import svcStudio from "../assets/img/svc-studio.jpg";
import svcEveniment from "../assets/img/svc-eveniment.jpg";
import svcVideo from "../assets/img/svc-video.jpg";
import echipament from "../assets/img/echipament.jpg";
import pNuntaCamp from "../assets/img/p-nunta-camp.jpg";

const serviceImages = {
  "foto-studio": svcStudio,
  "foto-eveniment": svcEveniment,
  "video-eveniment": svcVideo,
};

const serviceCards = [
  {
    ...services[0],
    no: "01",
    title: "Foto studio",
    lead: "Lumina sub control, de fiecare dată",
    body: "Portret, produs sau lookbook. Studioul de 80 mp are ciclorama albă, cinci culori de hârtie și lumini Profoto. Vii cu ideea, pleci cu fișierele prelucrate.",
  },
  {
    ...services[1],
    no: "02",
    title: "Foto eveniment",
    lead: "Ce se întâmplă, nu ce regizăm noi",
    body: "Nuntă, botez, cununie, eveniment de firmă. Fotografiem documentar, cu puține poziții cerute. La nunțile de peste 120 de invitați venim cu doi fotografi.",
  },
  {
    ...services[2],
    no: "03",
    title: "Video eveniment",
    lead: "Trei filme, nu un fișier",
    body: "Teaser de 60 de secunde pentru social, highlight de cinci minute pentru familie și filmul integral, cu ceremonia și discursurile. Sunetul luat separat, cu lavaliere.",
  },
];

const beneficii = [
  "Ședință de pregătire, cu lista momentelor",
  "Doi fotografi la nunțile mari",
  "Backup dublu al cardurilor, în aceeași seară",
  "Galerie online privată pentru invitați",
  "Livrare în 21 de zile, scrisă în contract",
];
---

<Layout
  title="Cadru 35 — studio foto și foto-video de eveniment în București"
  description="Studio foto de 80 mp în București și echipă de foto-video pentru nunți, botezuri și evenimente de firmă. Livrare în 21 de zile, trecută în contract."
>
  <!-- ============================== HERO ============================== -->
  <section class="on-dark relative overflow-hidden bg-ink text-white">
    <div
      class="wrap grid gap-12 pb-24 pt-[140px] lg:grid-cols-[1fr_1.02fr] lg:gap-14 lg:pb-[90px] lg:pt-[200px]"
    >
      <!-- coloana de text -->
      <div class="wrap-inner max-w-[640px]">
        <p class="rebate mb-7" data-reveal>București · din 2016</p>
        <h1 class="h-hero" data-split>
          Fiecare eveniment are 35 de cadre care <Mark text="contează" />.
        </h1>
        <p class="lead mt-8" data-reveal style="--reveal-delay:120ms">
          Studio foto de 80 mp în București și echipă de foto-video la
          evenimentul tău. Îți dăm cadrele pe care le pui pe perete, nu 2000 de
          fișiere pe care nu le mai deschide nimeni.
        </p>
        <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--reveal-delay:170ms">
          <a href={url("/contact")} class="btn btn-accent">Cere o ofertă</a>
          <a href={url("/portofoliu")} class="btn btn-light">Vezi portofoliul</a>
        </div>

        <div class="mt-14 border-t border-[var(--rule-dark)] pt-8" data-reveal style="--reveal-delay:230ms">
          <p class="h-slab">Livrare în 21 de zile</p>
          <p class="body-18 mt-3 max-w-[440px]">
            Termenul e trecut în contract, nu spus la telefon.
          </p>
        </div>
      </div>

      <!-- colajul: trei cadre drepte, cu numerele de pe rolă -->
      <div class="relative" data-reveal style="--reveal-delay:300ms">
        <Ornament
          type="crop"
          class="pointer-events-none absolute -right-4 -top-7 z-10 hidden h-11 w-11 text-white/40 lg:block"
        />
        <div class="grid grid-cols-[240fr_360fr] gap-4">
          <div class="flex flex-col gap-8 lg:pt-16">
            <figure class="frame">
              <Image
                src={pFashion}
                alt="Ședință de studio: femeie în palton lung, pe fundal de hârtie deschis"
                widths={[240, 480, 720]}
                sizes="(min-width:1024px) 17vw, 36vw"
                class="aspect-[3/4] w-full object-cover"
                loading="eager"
              />
            </figure>
            <figure class="frame">
              <Image
                src={heroVideo}
                alt="Videograf filmând cu camera pe gimbal la un eveniment de seară"
                widths={[240, 480, 720]}
                sizes="(min-width:1024px) 17vw, 36vw"
                class="aspect-[3/4] w-full object-cover"
                loading="eager"
              />
            </figure>
          </div>
          <figure class="frame self-start">
            <Image
              src={heroNunta}
              alt="Miri dansând seara sub ghirlande de becuri calde"
              widths={[380, 760, 1100]}
              sizes="(min-width:1024px) 26vw, 56vw"
              class="aspect-[3/4.6] w-full object-cover"
              loading="eager"
            />
          </figure>
        </div>
        <p class="rebate mt-3 flex justify-between opacity-70" aria-hidden="true">
          <span>34A</span><span>35</span><span>35A</span>
        </p>
      </div>
    </div>

    <Perfs class="text-white/45" />
  </section>

  <LogoBar />

  <!-- ========================= DE CE CADRU 35 ========================= -->
  <section class="section relative overflow-hidden pb-0">
    <div class="pointer-events-none absolute -left-8 top-[60px] hidden w-[220px] xl:block">
      <Image
        src={studioLumini}
        alt=""
        aria-hidden="true"
        widths={[240, 480]}
        sizes="220px"
        class="aspect-[3/4] w-full object-cover"
        loading="lazy"
      />
    </div>
    <div class="pointer-events-none absolute -right-6 top-[100px] hidden w-[190px] xl:block">
      <Image
        src={pNuntaCamp}
        alt=""
        aria-hidden="true"
        widths={[200, 400]}
        sizes="190px"
        class="aspect-[4/5] w-full object-cover"
        loading="lazy"
      />
    </div>

    <div class="wrap relative text-center">
      <Ornament
        type="sprocket"
        class="mx-auto mb-10 h-8 w-[250px] text-accent/75"
      />
      <h2 class="h-section mx-auto max-w-[880px]" data-split>
        De ce „Cadru 35”?
      </h2>
      <p class="lead mx-auto mt-7 max-w-[720px]" data-reveal style="--reveal-delay:80ms">
        O rolă de film de 35 mm are 36 de cadre. În practică, unul se pierde
        mereu la încărcare, așa că rămân 35. De acolo ne vine numele și felul în
        care lucrăm: nu numărăm pozele, ne uităm la cadrele care chiar spun ceva.
      </p>
    </div>
  </section>

  <!-- ============================ BENEFICII =========================== -->
  <section class="section relative overflow-hidden pb-0">
    <div class="grid items-center gap-10 lg:grid-cols-[763fr_677fr] lg:gap-0">
      <!-- imaginea iese din cadru spre stânga -->
      <div class="relative lg:-ml-[150px] lg:w-[813px]">
        <Image
          src={echipament}
          alt="Aparate foto, obiective și exponometru așezate pe un birou închis la culoare"
          widths={[520, 860, 1200]}
          sizes="(min-width:1024px) 56vw, 100vw"
          class="aspect-[3/2] w-full object-cover"
          loading="lazy"
          data-reveal="left"
        />
      </div>

      <div class="wrap-inner px-6 lg:max-w-[640px] lg:px-0">
        <p class="eyebrow" data-reveal>Cum lucrăm</p>
        <h2 class="h-section mt-5" data-reveal style="--reveal-delay:60ms">
          La baza fiecărui eveniment stă o listă de cadre
        </h2>
        <p class="body-18 mt-6" data-reveal style="--reveal-delay:100ms">
          Înainte de filmare stabilim împreună lista: momentele obligatorii,
          oamenii care nu trebuie rataţi, ordinea zilei. Așa nu descoperim la
          montaj că lipsește dansul cu părinții sau discursul nașului.
        </p>

        <ul class="mt-9 divide-y divide-[var(--rule)] border-y border-[var(--rule)]">
          {
            beneficii.map((item, i) => (
              <li
                class="flex items-baseline gap-4 py-3.5 text-[17px] leading-[28px]"
                data-reveal
                style={`--reveal-delay:${140 + i * 60}ms`}
              >
                <span class="rebate w-8 shrink-0 tabular-nums" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================= SERVICII =========================== -->
  <section class="section-lg relative overflow-hidden bg-paper-alt">
    <div class="wrap">
      <SectionHead
        eyebrow="Servicii"
        title="Trei feluri în care lucrăm"
        text="Studioul rezolvă tot ce se fotografiază pe fundal curat, cu lumina sub control. Echipa merge pe teren pentru tot ce se întâmplă o singură dată și nu se repetă."
        align="left"
        class="max-w-[720px]"
      />

      <div class="mt-16 grid gap-x-8 gap-y-14 md:grid-cols-3">
        {
          serviceCards.map((service, i) => (
            <article data-reveal style={`--reveal-delay:${100 + i * 300}ms`}>
              <a href={url(service.href)} class="group block">
                <figure class="frame relative">
                  <Image
                    src={serviceImages[service.slug as keyof typeof serviceImages]}
                    alt={service.title}
                    widths={[340, 640, 900]}
                    sizes="(min-width:768px) 30vw, 92vw"
                    class="aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                  <span class="rebate absolute left-3 top-3 bg-ink/75 px-2 py-1 !text-white">
                    {service.no}
                  </span>
                </figure>
                <h3 class="mt-6 font-display text-[27px] leading-[1.15] transition-colors duration-200 group-hover:text-accent-ink">
                  {service.title}
                </h3>
                <p class="mt-1.5 text-[15px] font-semibold uppercase tracking-[0.1em] text-accent-ink">
                  {service.lead}
                </p>
              </a>
              <p class="body-18 mt-4">{service.body}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-16" data-reveal>
        <a href={url("/servicii")} class="btn btn-ink">Toate serviciile</a>
      </div>
    </div>
  </section>

  <!-- =========================== CONTACT SHEET ======================== -->
  <section class="on-dark relative overflow-hidden bg-ink text-white">
    <div class="wrap py-20 lg:py-24">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-[640px]">
          <p class="eyebrow" data-reveal>Rola 12 · septembrie</p>
          <h2 class="h-section mt-5" data-reveal style="--reveal-delay:60ms">
            Cum arată o rolă întreagă
          </h2>
          <p class="lead mt-6" data-reveal style="--reveal-delay:100ms">
            Nu doar cadrele alese. Așa arată o zi de lucru pe un contact sheet,
            cu tot cu ratările dintre ele. Cele însemnate cu creion sunt cele
            care ajung în galeria ta.
          </p>
        </div>
        <a href={url("/portofoliu")} class="btn btn-light shrink-0" data-reveal>
          Portofoliul complet
        </a>
      </div>

      <ContactSheet />
    </div>
  </section>

  <!-- ============================== DESPRE ============================ -->
  <section class="section-lg">
    <div class="wrap grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div>
        <p class="eyebrow" data-reveal>Cum gândim</p>
        <h2 class="h-section mt-5" data-reveal style="--reveal-delay:60ms">
          Selecția, nu <Mark text="numărul" />
        </h2>
      </div>
      <div class="max-w-[640px]">
        <p class="lead" data-reveal style="--reveal-delay:100ms">
          Pe film aveai 35 de cadre și atât. Nu trăgeai 400 de poze ca să alegi
          mai târziu, gândeai cadrul înainte să apeși.
        </p>
        <p class="body-18 mt-6" data-reveal style="--reveal-delay:140ms">
          Lucrăm digital, evident, dar mentalitatea a rămas. La o nuntă predăm în
          jur de 600 de fotografii alese, nu 3000 de duplicate. E și motivul
          pentru care nu vindem „pachetul cu cele mai multe poze”: vindem
          selecția pe care o poți privi cap-coadă, într-o seară, fără să
          derulezi.
        </p>
        <div class="mt-9" data-reveal style="--reveal-delay:180ms">
          <a href={url("/despre-noi")} class="btn btn-ink">Despre noi</a>
        </div>
      </div>
    </div>
  </section>

  <Marquee />
  <CtaBand />
</Layout>

---
import Mark from "../components/Mark.astro";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SectionHead from "../components/SectionHead.astro";
import Stats from "../components/Stats.astro";
import Testimonials from "../components/Testimonials.astro";
import CtaBand from "../components/CtaBand.astro";
import Ornament from "../components/Ornament.astro";

import echipa from "../assets/img/echipa.jpg";
import film35 from "../assets/img/film-35mm.jpg";
import spatiu1 from "../assets/img/spatiu-studio-1.jpg";
import echipament from "../assets/img/echipament.jpg";

// TODO(real): numele și rolurile reale ale echipei + portrete proprii
const oameni = [
  {
    name: "Andrei",
    role: "Fotograf principal, evenimente",
    text: "A început pe film, în 2014, la nunți în Argeș. Se ocupă de partea documentară a zilei și de lista de cadre.",
  },
  {
    name: "Cristina",
    role: "Fotograf de studio",
    text: "Lucrează portret, produs și fashion. A pus la punct setup-ul de lumini din studio și îl reglează pentru fiecare ședință.",
  },
  {
    name: "Robert",
    role: "Videograf și montaj",
    text: "Filmează, înregistrează sunetul separat și montează. Dacă filmul iese lung, el e cel care taie fără milă.",
  },
];

const valori = [
  {
    title: "Nu vindem numărul de poze",
    text: "Un pachet cu 3000 de fotografii nu e mai bun, e doar nesortat. Predăm selecția, plus toate cadrele brute dacă le ceri.",
  },
  {
    title: "Termenul e în contract",
    text: "21 de zile lucrătoare, scris negru pe alb. Dacă întârziem din vina noastră, scădem 10% din preț pentru fiecare săptămână.",
  },
  {
    title: "Un singur interlocutor",
    text: "Vorbești cu omul care vine la evenimentul tău, nu cu un cont de vânzări. Aceeași persoană răspunde și după livrare.",
  },
  {
    title: "Spunem și când nu ne potrivim",
    text: "Dacă îți dorești un stil pe care nu îl facem bine, îți recomandăm pe altcineva. E mai ieftin pentru toată lumea decât un regret.",
  },
];
---

<Layout
  title="Despre noi — Cadru 35, studio foto-video București"
  description="Echipă de trei oameni, studio propriu de 80 mp în București și fotografie de eveniment din 2014. Cum lucrăm și de ce ne numim Cadru 35."
>
  <!-- Hero -->
  <section
    class="on-dark relative overflow-hidden bg-ink text-white"
    style="padding-top: var(--header-h)"
  >
    <div class="wrap grid items-center gap-12 py-16 lg:grid-cols-[1fr_0.85fr] lg:gap-16 lg:py-24">
      <div>
        <p class="eyebrow" data-reveal>Despre noi</p>
        <h1 class="h-hero mt-5" data-reveal style="--reveal-delay:60ms">
          Trei oameni, un studio și multe <Mark text="sâmbete" /> ocupate
        </h1>
        <p class="lead mt-7 max-w-xl" data-reveal style="--reveal-delay:110ms">
          Am început în 2014, cu un aparat pe film și nunți de weekend prin
          Argeș. Studioul din București a venit în 2019, când ne-am dat seama că
          jumătate din cereri erau pentru portret și produs, nu pentru evenimente.
        </p>
      </div>
      <div class="relative" data-reveal style="--reveal-delay:120ms">
        <Ornament
          type="crop"
          class="pointer-events-none absolute -right-4 -top-4 h-11 w-11 text-white/35 md:h-14 md:w-14"
        />
        <div class="frame">
          <Image
            src={echipa}
            alt="Doi fotografi verificând împreună ecranul unui aparat în studio"
            widths={[420, 760, 1040]}
            sizes="(min-width:1024px) 38vw, 92vw"
            class="aspect-[4/5] w-full object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <Stats />

  <!-- Povestea numelui -->
  <section class="section">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <div class="frame mx-auto w-full max-w-[380px]">
          <Image
            src={film35}
            alt="Rolă de film de 35 mm și un aparat foto vechi pe hârtie crem"
            widths={[380, 620, 800]}
            sizes="(min-width:1024px) 36vw, 80vw"
            class="aspect-square w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
      <div>
        <p class="eyebrow" data-reveal>Povestea numelui</p>
        <h2 class="h-section mt-4" data-reveal style="--reveal-delay:60ms">
          De ce „Cadru 35”
        </h2>
        <p class="lead mt-6" data-reveal style="--reveal-delay:100ms">
          O rolă de film de 35 mm are 36 de cadre. În practică, primul se pierde
          mereu la încărcare, așa că rămân 35. Când plecai la un eveniment cu
          două role, aveai 70 de șanse și atât — te uitai altfel la ce se
          întâmplă în fața ta.
        </p>
        <p class="lead mt-5" data-reveal style="--reveal-delay:140ms">
          Lucrăm digital de mult, evident. Dar felul de a privi a rămas: gândim
          cadrul înainte să apăsăm, iar la final îți dăm o selecție pe care o poți
          parcurge cap-coadă într-o seară.
        </p>
      </div>
    </div>
  </section>

  <!-- Echipa -->
  <section class="section bg-paper-alt">
    <div class="wrap">
      <SectionHead
        eyebrow="Echipa"
        title="Cine vine la evenimentul tău"
        text="Suntem trei. La nunțile mari chemăm încă doi colegi cu care lucrăm de ani buni, nu freelanceri găsiți cu o săptămână înainte."
        class="mb-14"
      />
      <div class="grid gap-6 md:grid-cols-3">
        {
          oameni.map((p, i) => (
            <article
              class="bg-paper-alt p-9"
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}
            >
              <h3 class="serif text-[1.7rem] leading-none">{p.name}</h3>
              <p class="eyebrow mt-3">{p.role}</p>
              <p class="mt-5 body-18">
                {p.text}
              </p>
            </article>
          ))
        }
      </div>
      <p class="mt-8 text-center text-[16px] text-[var(--text-body)]">
        {/* TODO(real): portrete reale ale echipei, făcute în studio */}
        Portretele echipei le adăugăm după ședința din studio.
      </p>
    </div>
  </section>

  <!-- Valori -->
  <section class="on-dark bg-ink text-white">
    <div class="wrap py-20 lg:py-28">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="eyebrow">Cum lucrăm</p>
        <h2 class="h-section mt-4">
          Patru lucruri pe care le spunem din prima
        </h2>
      </div>
      <div class="mt-14 grid gap-x-14 gap-y-12 md:grid-cols-2">
        {
          valori.map((v, i) => (
            <div
              class="border-t border-white/12 pt-7"
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
            >
              <p class="serif text-[2rem] leading-none text-accent">
                {String(i + 1).padStart(2, "0")}
              </p>
              <h3 class="h-sub mt-4">{v.title}</h3>
              <p class="lead mt-4">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Studio + echipament -->
  <section class="section">
    <div class="wrap grid gap-6 md:grid-cols-2">
      <Image
        src={spatiu1}
        alt="Interiorul studioului cu ciclorama albă și echipament pe stative"
        widths={[420, 760, 1040]}
        sizes="(min-width:768px) 46vw, 92vw"
        class="aspect-[4/3] w-full object-cover"
        loading="lazy"
      />
      <Image
        src={echipament}
        alt="Aparate foto, obiective și exponometru așezate pe un birou închis la culoare"
        widths={[420, 760, 1040]}
        sizes="(min-width:768px) 46vw, 92vw"
        class="aspect-[4/3] w-full object-cover"
        loading="lazy"
      />
    </div>
  </section>

  <Testimonials />
  <CtaBand />
</Layout>

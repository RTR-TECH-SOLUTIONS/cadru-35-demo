---
import Mark from "../components/Mark.astro";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import Ornament from "../components/Ornament.astro";
import { site } from "../data/site";

import spatiu2 from "../assets/img/spatiu-studio-2.jpg";
---

<Layout
  title="Contact — Cadru 35, studio foto-video București"
  description="Scrie-ne data evenimentului sau intervalul dorit în studio. Răspundem în aceeași zi lucrătoare, cu disponibilitate și preț ferm."
>
  <!-- Hero -->
  <section
    class="on-dark relative overflow-hidden bg-ink text-white"
    style="padding-top: var(--header-h)"
  >
    <Ornament
      type="crosshair"
      class="pointer-events-none absolute right-8 bottom-8 h-14 w-14 text-white/25 md:h-16 md:w-16"
    />
    <div class="wrap-tight py-16 text-center md:py-20">
      <p class="eyebrow" data-reveal>Contact</p>
      <h1 class="h-hero mt-5" data-reveal style="--reveal-delay:60ms">
        Spune-ne data și îți zicem dacă suntem <Mark text="liberi" />
      </h1>
      <p class="lead mx-auto mt-7 max-w-2xl" data-reveal style="--reveal-delay:110ms">
        Răspundem în aceeași zi lucrătoare, cu disponibilitatea și un preț ferm.
        Fără formulare care se pierd.
      </p>
    </div>
  </section>

  <!-- Formular + date -->
  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
      <div data-reveal>
        <h2 class="font-display text-[23px] font-semibold leading-[1.2]">Scrie-ne câteva rânduri</h2>
        <p class="mt-3 body-18">
          Completează și îți deschidem conversația pe WhatsApp cu mesajul deja
          scris. Poți să îl modifici înainte să îl trimiți.
        </p>
        <div class="mt-9">
          <ContactForm />
        </div>
      </div>

      <aside class="lg:pt-2" data-reveal style="--reveal-delay:120ms">
        <div class="bg-paper-alt p-9">
          <h2 class="eyebrow">Date de contact</h2>
          <ul class="mt-6 space-y-4 text-[18px]">
            <li>
              <a
                href={site.phoneHref}
                class="serif text-[1.6rem] leading-none transition-colors hover:text-accent"
                >{site.phone}</a
              >
            </li>
            <li>
              <a
                href={`mailto:${site.email}`}
                class="transition-colors hover:text-accent">{site.email}</a
              >
            </li>
            <li class="text-[var(--text-body)]">{site.address}</li>
          </ul>

          <h2 class="eyebrow mt-10">Program</h2>
          <dl class="mt-5 space-y-2.5 text-[0.95rem]">
            {
              site.schedule.map(([zi, ore]) => (
                <div class="flex justify-between gap-4 border-b border-[var(--rule)] pb-2.5">
                  <dt class="text-[var(--text-body)]">{zi}</dt>
                  <dd>{ore}</dd>
                </div>
              ))
            }
          </dl>

          <a
            href={`https://wa.me/${site.whatsapp}`}
            target="_blank"
            rel="noopener"
            class="btn btn-ink mt-9 w-full justify-center"
          >
            Scrie direct pe WhatsApp
          </a>
        </div>

        <div class="mt-6 overflow-hidden">
          <Image
            src={spatiu2}
            alt="Colț de studio cu role de hârtie colorată și un scaun"
            widths={[420, 760]}
            sizes="(min-width:1024px) 32vw, 92vw"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
        </div>
        {/* TODO(real): hartă Google Maps embed cu adresa reală a studioului */}
      </aside>
    </div>
  </section>
</Layout>
